{
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:qlik-oss/picasso.js.git"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production FORCE_COLOR=1 lerna run build --stream",
    "build:dev": "cross-env FORCE_COLOR=1 lerna run build --stream",
    "build:watch": "cross-env FORCE_COLOR=1 lerna run build:watch --stream --no-sort",
    "bump": "lerna publish --no-push",
    "clean": "lerna clean",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "cross-env FORCE_COLOR=1 lerna run lint",
    "link": "lerna link",
    "test": "npm run test:unit && npm run test:component",
    "test:component": "vitest run --config vitest.component.config.js",
    "test:integration:ci": "node ./test/scripts/run-integration-tests.js",
    "test:integration:local": "vitest run --config vitest.integration.config.js --maxWorkers=1",
    "test:integration:server": "rollup -c ./test/integration/rollup.config.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "prepare": "husky",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/cli": "8.1.0",
    "@babel/core": "8.1.0",
    "@babel/eslint-parser": "8.0.7",
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "1.64.1",
    "@qlik/oxfmt-config": "0.2.4",
    "@qlik/oxlint-config": "0.8.5",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "babel-plugin-istanbul": "8.0.0",
    "cross-env": "10.1.0",
    "extend": "3.0.2",
    "globals": "17.14.0",
    "globby": "16.2.4",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "lerna": "10.1.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rollup": "4.67.4",
    "rollup-plugin-serve": "3.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
