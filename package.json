{
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:qlik-oss/picasso.js.git"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production FORCE_COLOR=1 lerna run build --stream",
    "build:dev": "cross-env FORCE_COLOR=1 lerna run build --stream",
    "build:watch": "cross-env FORCE_COLOR=1 lerna run build:watch --stream --no-sort",
    "bump": "lerna publish --no-push",
    "clean": "lerna clean",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "cross-env FORCE_COLOR=1 lerna run lint",
    "link": "lerna link",
    "test": "npm run test:unit && npm run test:component",
    "test:component": "vitest run --config vitest.component.config.js",
    "test:integration:ci": "node ./test/scripts/run-integration-tests.js",
    "test:integration:local": "vitest run --config vitest.integration.config.js --maxWorkers=1",
    "test:integration:server": "rollup -c ./test/integration/rollup.config.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "prepare": "husky",
    "types:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@babel/cli": "8.0.6",
    "@babel/core": "8.0.6",
    "@babel/eslint-parser": "8.0.6",
    "@babel/plugin-transform-react-jsx": "8.0.1",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-react": "8.0.1",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@qlik/oxfmt-config": "0.2.2",
    "@qlik/oxlint-config": "0.8.3",
    "@rollup/plugin-babel": "7.1.0",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "babel-plugin-istanbul": "8.0.0",
    "cross-env": "10.1.0",
    "extend": "3.0.2",
    "globals": "17.13.0",
    "globby": "16.2.4",
    "husky": "9.1.7",
    "jsdom": "30.1.2",
    "lerna": "10.0.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "rollup": "2.80.0",
    "rollup-plugin-serve": "1.1.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
